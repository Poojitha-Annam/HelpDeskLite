PORT=8000

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=helpdesk_lite
DB_SSL=true

JWT_SECRET=your-super-secret-jwt-key-64-chars-minimum

# One-time Manager bootstrap key — keep this secret, never commit the real value
# After the Manager account is created this key has no further use
MANAGER_SETUP_KEY=your-secret-setup-key-here
